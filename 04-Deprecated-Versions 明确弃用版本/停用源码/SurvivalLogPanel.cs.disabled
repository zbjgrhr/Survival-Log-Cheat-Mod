using System;
using System.Diagnostics;
using System.Drawing;
using System.IO;
using System.Linq;
using System.Runtime.InteropServices;
using System.Threading;
using System.Windows.Forms;

internal static class Program
{
    [STAThread]
    private static void Main()
    {
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);
        Application.Run(new TrainerPanel());
    }
}

internal sealed class TrainerPanel : Form
{
    private const string TrainerPath = @"C:\tool\steam\steamapps\common\Survival Log\末日生存日志作弊器.exe";
    private readonly Label status;
    private readonly Color baseColor = Color.FromArgb(18, 27, 31);
    private readonly Color surfaceColor = Color.FromArgb(29, 42, 47);
    private readonly Color inkColor = Color.FromArgb(230, 240, 231);
    private readonly Color accentColor = Color.FromArgb(172, 217, 160);
    private readonly System.Windows.Forms.Timer statusTimer;

    [DllImport("user32.dll")]
    private static extern void keybd_event(byte virtualKey, byte scan, uint flags, UIntPtr extraInfo);

    private const uint KeyRelease = 2;

    public TrainerPanel()
    {
        Text = "末日生存日志作弊器 · 控制面板";
        try { Icon = Icon.ExtractAssociatedIcon(Application.ExecutablePath); } catch { }
        ClientSize = new Size(492, 404);
        MinimumSize = new Size(430, 350);
        MaximumSize = new Size(760, 700);
        StartPosition = FormStartPosition.CenterScreen;
        BackColor = baseColor;
        ForeColor = inkColor;
        Font = new Font("Microsoft YaHei UI", 9F);
        AutoScaleMode = AutoScaleMode.Dpi;
        FormBorderStyle = FormBorderStyle.Sizable;
        MaximizeBox = false;

        var header = new Panel { Dock = DockStyle.Top, Height = 74, BackColor = surfaceColor };
        var title = new Label {
            Text = "SURVIVAL LOG  /  控制台", AutoSize = true,
            Font = new Font("Microsoft YaHei UI", 15F, FontStyle.Bold),
            ForeColor = accentColor, Location = new Point(16, 10)
        };
        status = new Label {
            Text = "检测中…", AutoSize = true,
            Font = new Font("Microsoft YaHei UI", 8.5F),
            ForeColor = Color.FromArgb(183, 197, 188), Location = new Point(18, 47)
        };
        header.Controls.Add(title);
        header.Controls.Add(status);
        var help = new Button {
            Text = "?", Width = 30, Height = 28,
            Anchor = AnchorStyles.Top | AnchorStyles.Right,
            Location = new Point(ClientSize.Width - 43, 11),
            FlatStyle = FlatStyle.Flat, BackColor = Color.FromArgb(53, 75, 77),
            ForeColor = inkColor, Font = new Font("Microsoft YaHei UI", 10F, FontStyle.Bold)
        };
        help.FlatAppearance.BorderSize = 0;
        help.Click += delegate { ShowValueHelp(); };
        header.Resize += delegate { help.Left = header.ClientSize.Width - 43; };
        header.Controls.Add(help);
        Controls.Add(header);

        var footer = new Panel { Dock = DockStyle.Bottom, Height = 45, BackColor = surfaceColor };
        var launch = new Button {
            Text = "启动修改器", Width = 110, Height = 29,
            Location = new Point(12, 8), FlatStyle = FlatStyle.Flat,
            BackColor = Color.FromArgb(64, 92, 69), ForeColor = inkColor
        };
        launch.FlatAppearance.BorderSize = 0;
        launch.Click += delegate { LaunchTrainer(); };
        var hint = new Label {
            Text = "数值位置见右上角 ?", AutoSize = true,
            ForeColor = Color.FromArgb(169, 187, 177),
            Location = new Point(133, 14), Font = new Font("Microsoft YaHei UI", 8F)
        };
        footer.Controls.Add(launch);
        footer.Controls.Add(hint);
        Controls.Add(footer);

        var tabs = new TabControl { Dock = DockStyle.Fill, Font = new Font("Microsoft YaHei UI", 9F) };
        AddTab(tabs, "生存", new[] {
            Action("无限饱腹", 1), Action("无限心态", 2),
            Action("无限精力", 3), Action("无限生命", 4),
            Action("无限物品使用", 5), Action("物品保质期", 6),
            Action("建筑/家具耐久", 7), Action("无限发电输出", 8),
            Action("无限电池电量", 9), Action("最大负重", 0)
        });
        AddTab(tabs, "资源与成长", new[] {
            Action("增加金币（快捷键）", 1, 0x11), Action("生存点（快捷键）", 2, 0x11),
            Action("信念/规划点（快捷键）", 3, 0x11), Action("免费刷新规划", 4, 0x11),
            Action("满技能熟练度", 5, 0x11), Action("技能熟练度倍率", 6, 0x11),
            Action("免费制作", 4, 0x12), Action("解锁图鉴", 6, 0x12),
            Action("解锁全部成就", 7, 0x12), Action("解锁无尽模式", 5, 0x12)
        });
        AddTab(tabs, "时间与世界", new[] {
            Action("冻结昼夜", 7, 0x11), Action("时间流逝速度", 8, 0x11),
            Action("植物瞬间成熟", 1, 0x12), Action("烹饪瞬间完成", 2, 0x12),
            Action("烹饪无限燃料", 3, 0x12), Action("地图移动零耗时", 8, 0x12),
            Action("设置移动速度", 9, 0x12), Action("设置游戏速度", 0, 0x12)
        });
        Controls.Add(tabs);
        tabs.BringToFront();

        statusTimer = new System.Windows.Forms.Timer { Interval = 1800 };
        statusTimer.Tick += delegate { UpdateStatus(); };
        statusTimer.Start();
        Shown += delegate { UpdateStatus(); };
    }

    private static CheatAction Action(string label, int digit, int modifier = 0)
    {
        return new CheatAction(label, (byte)(0x60 + digit), (byte)modifier);
    }

    private void AddTab(TabControl tabs, string name, CheatAction[] actions)
    {
        var page = new TabPage(name) { BackColor = baseColor, Padding = new Padding(7) };
        var list = new TableLayoutPanel {
            Dock = DockStyle.Fill, AutoScroll = true,
            BackColor = baseColor, ColumnCount = 2,
            RowCount = (actions.Length + 1) / 2,
            Padding = new Padding(2)
        };
        list.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 50F));
        list.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 50F));
        for (int row = 0; row < list.RowCount; row++)
            list.RowStyles.Add(new RowStyle(SizeType.Absolute, 47F));
        for (int i = 0; i < actions.Length; i++) {
            CheatAction action = actions[i];
            var button = new Button {
                Text = action.Label, Dock = DockStyle.Fill,
                Margin = new Padding(3), FlatStyle = FlatStyle.Flat,
                BackColor = surfaceColor, ForeColor = inkColor,
                Font = new Font("Microsoft YaHei UI", 9F),
                UseVisualStyleBackColor = false
            };
            button.FlatAppearance.BorderColor = Color.FromArgb(62, 82, 84);
            button.Click += delegate { SendHotkey(action); };
            list.Controls.Add(button, i % 2, i / 2);
        }
        page.Controls.Add(list);
        tabs.TabPages.Add(page);
    }

    private bool TrainerRunning()
    {
        try {
            return Process.GetProcesses().Any(p =>
                p.ProcessName == "末日生存日志作弊器" ||
                p.ProcessName == "Survival Log v1.0 Plus 28 Trainer");
        } catch { return false; }
    }

    private void ShowValueHelp()
    {
        MessageBox.Show(this,
            "当前面板的按钮只发送原修改器快捷键，没有直接输入游戏数值的功能。\n\n" +
            "金币、生存点、信念/规划点、技能倍率、时间速度和移动速度的具体数字，需要在原修改器对应项目旁设置。\n\n" +
            "若原修改器窗口没有显示，当前版本面板无法替它填写数字；请不要把按钮提示理解为已设好数值。",
            "数值在哪里设置", MessageBoxButtons.OK, MessageBoxIcon.Information);
    }

    private void UpdateStatus()
    {
        bool game = Process.GetProcessesByName("SurvivalLog").Length > 0;
        bool trainer = TrainerRunning();
        status.Text = "游戏 " + (game ? "已运行" : "未运行") + "   ·   修改器 " + (trainer ? "已运行" : "未运行");
        status.ForeColor = game && trainer ? accentColor : Color.FromArgb(223, 184, 130);
    }

    private bool LaunchTrainer()
    {
        if (TrainerRunning()) { UpdateStatus(); return true; }
        if (!File.Exists(TrainerPath)) {
            MessageBox.Show(this, "找不到游戏目录中的修改器：\n" + TrainerPath,
                "修改器未找到", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            return false;
        }
        try {
            Process.Start(new ProcessStartInfo {
                FileName = TrainerPath,
                WorkingDirectory = Path.GetDirectoryName(TrainerPath),
                UseShellExecute = true
            });
            Thread.Sleep(450);
            UpdateStatus();
            return true;
        } catch (Exception error) {
            MessageBox.Show(this, "修改器启动失败：\n" + error.Message,
                "启动错误", MessageBoxButtons.OK, MessageBoxIcon.Error);
            return false;
        }
    }

    private void SendHotkey(CheatAction action)
    {
        if (!TrainerRunning() && !LaunchTrainer()) return;
        try {
            if (action.Modifier != 0)
                keybd_event(action.Modifier, 0, 0, UIntPtr.Zero);
            keybd_event(action.Key, 0, 0, UIntPtr.Zero);
            Thread.Sleep(50);
            keybd_event(action.Key, 0, KeyRelease, UIntPtr.Zero);
            if (action.Modifier != 0)
                keybd_event(action.Modifier, 0, KeyRelease, UIntPtr.Zero);
            status.Text = "已发送：" + action.Label + "   ·   再点一次可切换";
            status.ForeColor = accentColor;
        } catch (Exception error) {
            MessageBox.Show(this, error.Message, "快捷键发送失败",
                MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

    private sealed class CheatAction
    {
        public readonly string Label;
        public readonly byte Key;
        public readonly byte Modifier;
        public CheatAction(string label, byte key, byte modifier)
        { Label = label; Key = key; Modifier = modifier; }
    }
}
