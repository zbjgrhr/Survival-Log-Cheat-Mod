Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$nativeSource = @'
using System;
using System.Runtime.InteropServices;
public static class TrainerKeys {
  [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
  [DllImport("user32.dll")] public static extern void keybd_event(byte bVk, byte bScan, uint dwFlags, UIntPtr dwExtraInfo);
  public const uint KEYEVENTF_KEYUP = 0x0002;
}
'@
Add-Type -TypeDefinition $nativeSource

function Get-TrainerProcess {
    Get-Process -ErrorAction SilentlyContinue | Where-Object {
        $_.ProcessName -match '^(末日生存日志作弊器|Survival Log v1\.0 Plus 28 Trainer)$'
    } | Select-Object -First 1
}

function Send-TrainerKey([byte]$key, [byte[]]$modifiers = @()) {
    $trainer = Get-TrainerProcess
    if ($null -eq $trainer) {
        [System.Windows.Forms.MessageBox]::Show(
            '未检测到修改器。请先启动“末日生存日志作弊器.exe”，再点击面板按钮。',
            '修改器未运行', 'OK', 'Warning'
        ) | Out-Null
        return
    }
    # 该修改器使用全局快捷键；不抢走游戏焦点，按键也能被它接收。
    foreach ($modifier in $modifiers) { [TrainerKeys]::keybd_event($modifier, 0, 0, [UIntPtr]::Zero) }
    [TrainerKeys]::keybd_event($key, 0, 0, [UIntPtr]::Zero)
    Start-Sleep -Milliseconds 35
    [TrainerKeys]::keybd_event($key, 0, [TrainerKeys]::KEYEVENTF_KEYUP, [UIntPtr]::Zero)
    for ($index = $modifiers.Count - 1; $index -ge 0; $index--) {
        [TrainerKeys]::keybd_event($modifiers[$index], 0, [TrainerKeys]::KEYEVENTF_KEYUP, [UIntPtr]::Zero)
    }
}

function New-ActionButton([string]$text, [byte]$key, [byte[]]$modifiers = @()) {
    $button = New-Object System.Windows.Forms.Button
    $button.Text = $text
    $button.Height = 44
    $button.Width = 178
    $button.Margin = New-Object System.Windows.Forms.Padding(5)
    $button.FlatStyle = 'Flat'
    $button.FlatAppearance.BorderColor = [System.Drawing.Color]::FromArgb(67, 87, 96)
    $button.FlatAppearance.BorderSize = 1
    $button.BackColor = [System.Drawing.Color]::FromArgb(30, 42, 48)
    $button.ForeColor = [System.Drawing.Color]::FromArgb(232, 238, 231)
    $button.Font = New-Object System.Drawing.Font('Microsoft YaHei UI', 9, [System.Drawing.FontStyle]::Regular)
    $button.Tag = [PSCustomObject]@{ Key = $key; Modifiers = [byte[]]$modifiers }
    $button.Add_Click({
        param($sender, $eventArgs)
        $binding = $sender.Tag
        Send-TrainerKey $binding.Key $binding.Modifiers
    })
    return $button
}

$form = New-Object System.Windows.Forms.Form
$form.Text = '末日生存日志 · 控制面板'
$form.ClientSize = New-Object System.Drawing.Size(826, 640)
$form.MinimumSize = New-Object System.Drawing.Size(842, 679)
$form.StartPosition = 'CenterScreen'
$form.BackColor = [System.Drawing.Color]::FromArgb(15, 22, 25)
$form.ForeColor = [System.Drawing.Color]::FromArgb(232, 238, 231)
$form.Font = New-Object System.Drawing.Font('Microsoft YaHei UI', 9)
$form.FormBorderStyle = 'FixedSingle'
$form.MaximizeBox = $false

$header = New-Object System.Windows.Forms.Panel
$header.Dock = 'Top'; $header.Height = 94
$header.BackColor = [System.Drawing.Color]::FromArgb(20, 32, 36)
$title = New-Object System.Windows.Forms.Label
$title.Text = 'SURVIVAL  //  FIELD CONSOLE'
$title.Location = New-Object System.Drawing.Point(26, 17); $title.AutoSize = $true
$title.Font = New-Object System.Drawing.Font('Bahnschrift SemiBold', 19, [System.Drawing.FontStyle]::Bold)
$title.ForeColor = [System.Drawing.Color]::FromArgb(202, 225, 198)
$subTitle = New-Object System.Windows.Forms.Label
$subTitle.Text = '末日生存日志 · 本地控制面板  |  点击按钮即可向已启动的修改器发送快捷键'
$subTitle.Location = New-Object System.Drawing.Point(28, 56); $subTitle.AutoSize = $true
$subTitle.ForeColor = [System.Drawing.Color]::FromArgb(143, 166, 158)
$header.Controls.AddRange(@($title, $subTitle)); $form.Controls.Add($header)

$tabs = New-Object System.Windows.Forms.TabControl
$tabs.Dock = 'Fill'; $tabs.Padding = New-Object System.Drawing.Point(18, 8)
$tabs.Appearance = 'FlatButtons'; $tabs.BackColor = $form.BackColor

function New-Tab([string]$name) {
    $tab = New-Object System.Windows.Forms.TabPage
    $tab.Text = $name; $tab.BackColor = [System.Drawing.Color]::FromArgb(15, 22, 25)
    $flow = New-Object System.Windows.Forms.FlowLayoutPanel
    $flow.Dock = 'Fill'; $flow.Padding = New-Object System.Windows.Forms.Padding(17, 18, 17, 5)
    $flow.AutoScroll = $true; $flow.BackColor = $tab.BackColor
    $tab.Controls.Add($flow); $tabs.TabPages.Add($tab); return $flow
}

